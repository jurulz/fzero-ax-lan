+// ---------------------------------------------------------------------------------------------
+// Cabinet link emulation (F-Zero AX, Mario Kart GP...).
+// On real hardware the media board firmware keeps an array of fixed-size blocks in the "link RAM"
+// (NetworkBufferAddress2). Block N belongs to cabinet N and lives at N * block_size. The game
+// writes its own block and reads the others; the firmware mirrors every cabinet's block to all
+// the other cabinets over UDP. SearchDevices is issued by the game once per frame.
+// Here the blocks are mirrored by UDP datagrams addressed to the peers of the IP redirection table
+// (emulated 192.168.11.x -> real IP).
+// ---------------------------------------------------------------------------------------------
+static constexpr u32 LINK_RAM_BASE = NetworkBufferAddress2;
+static constexpr u32 LINK_DEFAULT_BLOCK_SIZE = 0x5a0;
+static constexpr u32 LINK_MAX_BLOCK_SIZE = 0x1000;
+static constexpr u16 LINK_DEFAULT_PORT = 58505;
+static constexpr u32 LINK_MAGIC = 0x4B4C5A46;  // "FZLK"
+static constexpr u32 LINK_HEADER_SIZE = 8;
+static constexpr u32 LINK_UNITS_PER_GROUP = 4;
+
+static u32 s_link_block_size = LINK_DEFAULT_BLOCK_SIZE;
+static u16 s_link_port = LINK_DEFAULT_PORT;
+static u32 s_link_num = LINK_UNITS_PER_GROUP;
+static SOCKET s_link_socket = INVALID_SOCKET;
+static std::thread s_link_thread;
+static std::atomic<bool> s_link_running{false};
+static std::atomic<u32> s_link_my_unit{0};
+static std::atomic<u32> s_link_tx{0};
+static std::atomic<u32> s_link_rx{0};
+
+static u32 LinkOwnUnit()
+{
+  // The game announces its own address (192.168.11.(number + group * 4 + 1)) with ModifyMyIPaddr.
+  const u32 last = s_game_modified_ip_address[3];
+  return last > 0 ? ((last - 1) % LINK_UNITS_PER_GROUP) : 0;
+}
+
+static void LinkHandlePacket(const u8* data, int size, const sockaddr_in& from)
+{
+  if (size < int(LINK_HEADER_SIZE))
+    return;
+  if (Common::BitCastPtr<u32>(data) != LINK_MAGIC)
+    return;
+
+  const u32 unit = data[4];
+  const u32 block_size = Common::BitCastPtr<u16>(data + 6);
+  if (unit >= LINK_UNITS_PER_GROUP || block_size == 0 || block_size > LINK_MAX_BLOCK_SIZE ||
+      int(LINK_HEADER_SIZE + block_size) != size || unit == s_link_my_unit.load())
+  {
+    return;
+  }
+
+  const auto dst = GetSpanForMediaboardAddress(LINK_RAM_BASE + unit * block_size);
+  if (dst.size() < block_size)
+    return;
+
+  std::memcpy(dst.data(), data + LINK_HEADER_SIZE, block_size);
+
+  const u32 count = ++s_link_rx;
+  if (count <= 3 || count % 1200 == 0)
+  {
+    INFO_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: link RX #{}: unit {} ({} bytes) from {}", count, unit,
+                 block_size,
+                 Common::IPAddressToString(std::bit_cast<Common::IPAddress>(from.sin_addr)));
+  }
+}
+
+static bool LinkStart()
+{
+  if (s_link_running)
+    return true;
+
+  const SOCKET sock = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (sock == INVALID_SOCKET)
+  {
+    ERROR_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: link: socket() failed: {}", Common::StrNetworkError());
+    return false;
+  }
+
+  const int reuse = 1;
+  setsockopt(sock, SOL_SOCKET, SO_REUSEADDR, reinterpret_cast<const char*>(&reuse), sizeof(reuse));
+#ifdef _WIN32
+  const int timeout_ms = 100;
+  setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&timeout_ms),
+             sizeof(timeout_ms));
+#else
+  const timeval timeout{.tv_sec = 0, .tv_usec = 100000};
+  setsockopt(sock, SOL_SOCKET, SO_RCVTIMEO, reinterpret_cast<const char*>(&timeout),
+             sizeof(timeout));
+#endif
+
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(s_link_port);
+  addr.sin_addr.s_addr = htonl(INADDR_ANY);
+  if (bind(sock, reinterpret_cast<const sockaddr*>(&addr), sizeof(addr)) != 0)
+  {
+    ERROR_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: link: bind(port {}) failed: {}", s_link_port,
+                  Common::StrNetworkError());
+    closesocket(sock);
+    return false;
+  }
+
+  s_link_socket = sock;
+  s_link_running = true;
+  s_link_thread = std::thread([sock] {
+    std::vector<u8> buffer(LINK_HEADER_SIZE + LINK_MAX_BLOCK_SIZE + 16);
+    while (s_link_running)
+    {
+      sockaddr_in from{};
+      socklen_t from_len = sizeof(from);
+      const int n = recvfrom(sock, reinterpret_cast<char*>(buffer.data()), int(buffer.size()), 0,
+                             reinterpret_cast<sockaddr*>(&from), &from_len);
+      if (n > 0)
+        LinkHandlePacket(buffer.data(), n, from);
+    }
+  });
+
+  NOTICE_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: link: listening on UDP port {}", s_link_port);
+  return true;
+}
+
+static void LinkStop()
+{
+  if (!s_link_running)
+    return;
+
+  s_link_running = false;
+  if (s_link_socket != INVALID_SOCKET)
+  {
+    closesocket(s_link_socket);
+    s_link_socket = INVALID_SOCKET;
+  }
+  if (s_link_thread.joinable())
+    s_link_thread.join();
+}
+
+// Called for every SearchDevices command: send our own block to every other cabinet.
+static void LinkSendOwnBlock()
+{
+  if (!LinkStart())
+    return;
+
+  const u32 unit = LinkOwnUnit();
+  s_link_my_unit = unit;
+  const u32 block_size = s_link_block_size;
+
+  const auto block = GetSpanForMediaboardAddress(LINK_RAM_BASE + unit * block_size);
+  if (block.size() < block_size)
+  {
+    ERROR_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: link: bad block for unit {}", unit);
+    return;
+  }
+
+  std::vector<u8> packet(LINK_HEADER_SIZE + block_size);
+  Common::BitCastPtr<u32>(packet.data()) = LINK_MAGIC;
+  packet[4] = u8(unit);
+  packet[5] = u8(LINK_UNITS_PER_GROUP);
+  Common::BitCastPtr<u16>(packet.data() + 6) = u16(block_size);
+  std::memcpy(packet.data() + LINK_HEADER_SIZE, block.data(), block_size);
+
+  const u32 my_last = s_game_modified_ip_address[3];
+  const u32 group_base = ((my_last > 0 ? my_last - 1 : 0) / LINK_UNITS_PER_GROUP) *
+                         LINK_UNITS_PER_GROUP;
+
+  u32 sent = 0;
+  for (u32 other = 0; other < s_link_num; ++other)
+  {
+    if (other == unit)
+      continue;
+
+    const Common::IPv4Port emulated{Common::IPAddress{192, 168, 11, u8(group_base + other + 1)},
+                                    htons(s_link_port)};
+    const auto real = AdjustIPv4PortFromConfig(emulated);
+    if (!real.has_value())
+      continue;
+
+    sockaddr_in to{};
+    to.sin_family = AF_INET;
+    to.sin_port = real->port;
+    to.sin_addr = std::bit_cast<in_addr>(real->ip_address);
+    if (sendto(s_link_socket, reinterpret_cast<const char*>(packet.data()), int(packet.size()), 0,
+               reinterpret_cast<const sockaddr*>(&to), sizeof(to)) >= 0)
+    {
+      ++sent;
+    }
+  }
+
+  const u32 count = ++s_link_tx;
+  if (count <= 3 || count % 1200 == 0)
+  {
+    INFO_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: link TX #{}: unit {} -> {} peer(s), block {} bytes",
+                 count, unit, sent, block_size);
+  }
+}
+
