+static void AMMBCommandSendTo(u32 parameter_offset)
+{
+  // Layout (observed in F-Zero AX's wrapper): socket, data offset, length, flags,
+  //  destination address offset, destination address length.
+  const auto guest_socket = GuestSocket(s_media_buffer_32[parameter_offset]);
+  const auto fd = GetHostSocket(guest_socket);
+  const u32 off = s_media_buffer_32[parameter_offset + 1];
+  u32 len = s_media_buffer_32[parameter_offset + 2];
+  const u32 flags = s_media_buffer_32[parameter_offset + 3];
+  const u32 addr_off = s_media_buffer_32[parameter_offset + 4];
+  const u32 addr_len = s_media_buffer_32[parameter_offset + 5];
+
+  s_media_buffer[1] = s_media_buffer[8];
+  s_media_buffer_32[1] = u32(SOCKET_ERROR);
+
+  const auto data_span = GetSpanForMediaboardAddress(off);
+  if (data_span.size() < len)
+  {
+    ERROR_LOG_FMT(AMMEDIABOARD_NET,
+                  "AMMBCommandSendTo: Bad data offset or length: off={:08x} len={}", off, len);
+    len = 0;
+  }
+
+  GuestSocketAddress guest_addr;
+  const auto addr_span = GetSpanForMediaboardAddress(addr_off);
+  if (addr_len != sizeof(guest_addr) || addr_span.size() < sizeof(guest_addr))
+  {
+    ERROR_LOG_FMT(AMMEDIABOARD_NET,
+                  "AMMBCommandSendTo: Bad address offset or length: off={:08x} len={}", addr_off,
+                  addr_len);
+    s_last_error = SSC_EFAULT;
+    return;
+  }
+
+  std::memcpy(&guest_addr, addr_span.data(), sizeof(guest_addr));
+
+  sockaddr_in addr{
+      .sin_family = guest_addr.ip_family,
+      .sin_port = guest_addr.port,
+      .sin_addr = std::bit_cast<in_addr>(guest_addr.ip_address),
+  };
+
+  if (const auto adjusted = AdjustIPv4PortFromConfig({guest_addr.ip_address, guest_addr.port}))
+  {
+    addr.sin_addr = std::bit_cast<in_addr>(adjusted->ip_address);
+    addr.sin_port = adjusted->port;
+
+    INFO_LOG_FMT(AMMEDIABOARD_NET, "AMMBCommandSendTo: Redirecting to: {}:{}",
+                 Common::IPAddressToString(adjusted->ip_address), ntohs(adjusted->port));
+  }
+
+  // Games use broadcasts to discover other cabinets.
+  if (std::bit_cast<u32>(addr.sin_addr) == u32(INADDR_BROADCAST))
+  {
+    const int enable = 1;
+    setsockopt(fd, SOL_SOCKET, SO_BROADCAST, reinterpret_cast<const char*>(&enable),
+               sizeof(enable));
+  }
+
+  const int ret = sendto(fd, reinterpret_cast<const char*>(data_span.data()), len, SEND_FLAGS,
+                         reinterpret_cast<const sockaddr*>(&addr), sizeof(addr));
+  const int err = WSAGetLastError();
+
+  if (ret < 0)
+  {
+    s_last_error = err == WSAEWOULDBLOCK ? u32(SSC_EWOULDBLOCK) : u32(SOCKET_ERROR);
+    ERROR_LOG_FMT(AMMEDIABOARD_NET,
+                  "GC-AM: sendto( {}({}), 0x{:08x}, {}, 0x{:x}, {}:{} ) failed with error {}: {}",
+                  fd, u32(guest_socket), off, len, flags,
+                  Common::IPAddressToString(std::bit_cast<Common::IPAddress>(addr.sin_addr)),
+                  ntohs(addr.sin_port), err, Common::DecodeNetworkError(err));
+  }
+  else
+  {
+    s_last_error = SSC_SUCCESS;
+    INFO_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: sendto( {}({}), 0x{:08x}, {}, 0x{:x}, {}:{} ): {}", fd,
+                  u32(guest_socket), off, len, flags,
+                  Common::IPAddressToString(std::bit_cast<Common::IPAddress>(addr.sin_addr)),
+                  ntohs(addr.sin_port), ret);
+  }
+
+  s_media_buffer_32[1] = u32(ret);
+}
+
+static void AMMBCommandRecvFrom(u32 parameter_offset)
+{
+  // Layout (observed in F-Zero AX's wrapper): socket, data offset, length, flags,
+  //  source address offset, source address length offset (u32 in/out).
+  const auto guest_socket = GuestSocket(s_media_buffer_32[parameter_offset]);
+  const auto fd = GetHostSocket(guest_socket);
+  const u32 off = s_media_buffer_32[parameter_offset + 1];
+  u32 len = s_media_buffer_32[parameter_offset + 2];
+  const u32 flags = s_media_buffer_32[parameter_offset + 3];
+  const u32 addr_off = s_media_buffer_32[parameter_offset + 4];
+  const u32 addrlen_off = s_media_buffer_32[parameter_offset + 5];
+
+  const auto data_span = GetSpanForMediaboardAddress(off);
+  if (data_span.size() < len)
+  {
+    ERROR_LOG_FMT(AMMEDIABOARD_NET,
+                  "AMMBCommandRecvFrom: Bad data offset or length: off={:08x} len={}", off, len);
+    len = 0;
+  }
+
+  sockaddr_in from{};
+  socklen_t from_len = sizeof(from);
+
+  // TODO: Might be blocking depending on the timeout (see SetTimeouts command).
+  const int ret = recvfrom(fd, reinterpret_cast<char*>(data_span.data()), len, 0,
+                           reinterpret_cast<sockaddr*>(&from), &from_len);
+  const int err = WSAGetLastError();
+
+  if (ret < 0)
+  {
+    s_last_error = err == WSAEWOULDBLOCK ? u32(SSC_EWOULDBLOCK) : u32(SOCKET_ERROR);
+
+    if (err != WSAEWOULDBLOCK)
+    {
+      ERROR_LOG_FMT(AMMEDIABOARD_NET,
+                    "GC-AM: recvfrom( {}({}), 0x{:08x}, {}, 0x{:x} ) failed with error {}: {}", fd,
+                    u32(guest_socket), off, len, flags, err, Common::DecodeNetworkError(err));
+    }
+  }
+  else
+  {
+    s_last_error = SSC_SUCCESS;
+
+    const auto addr_span = GetSpanForMediaboardAddress(addr_off);
+    const auto addrlen_span = GetSpanForMediaboardAddress(addrlen_off);
+
+    if (addr_off != 0 && addrlen_off != 0 && addrlen_span.size() >= sizeof(u32))
+    {
+      GuestSocketAddress guest_addr{
+          .ip_family = u8(from.sin_family),
+          .port = from.sin_port,
+          .ip_address = std::bit_cast<Common::IPAddress>(from.sin_addr),
+      };
+
+      if (const auto adjusted =
+              ReverseAdjustIPv4PortFromConfig({guest_addr.ip_address, guest_addr.port}))
+      {
+        guest_addr.ip_address = adjusted->ip_address;
+        guest_addr.port = adjusted->port;
+      }
+
+      const u32 write_size = std::min<u32>(
+          Common::BitCastPtr<u32>(addrlen_span.data()),
+          u32(std::min<std::size_t>(sizeof(guest_addr), addr_span.size())));
+      std::memcpy(addr_span.data(), &guest_addr, write_size);
+      Common::BitCastPtr<u32>(addrlen_span.data()) = sizeof(guest_addr);
+    }
+
+    INFO_LOG_FMT(AMMEDIABOARD_NET, "GC-AM: recvfrom( {}({}), 0x{:08x}, {}, 0x{:x} ): {} from {}:{}",
+                  fd, u32(guest_socket), off, len, flags, ret,
+                  Common::IPAddressToString(std::bit_cast<Common::IPAddress>(from.sin_addr)),
+                  ntohs(from.sin_port));
+  }
+
+  s_media_buffer[1] = s_media_buffer[8];
+  s_media_buffer_32[1] = u32(ret);
+}
