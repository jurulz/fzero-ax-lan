+FZeroAXCommon_IOAdapter::FZeroAXCommon_IOAdapter(FZeroAXSteeringWheel* steering_wheel)
+    : m_steering_wheel{steering_wheel}
+{
+  m_ffb = std::make_unique<WheelForceFeedback>();
+
+  Common::IniFile ini;
+  ini.Load(File::GetUserPath(F_DOLPHINCONFIG_IDX));
+  Common::IniFile::Section* const core = ini.GetOrCreateSection("Core");
+
+  bool enabled = true;
+  int tcp_port = 8000;
+  int udp_port = 8001;
+  core->Get("TriforceOutputs", &enabled, true);
+  core->Get("TriforceOutputsTcpPort", &tcp_port, 8000);
+  core->Get("TriforceOutputsUdpPort", &udp_port, 8001);
+
+  if (!enabled || tcp_port <= 0 || tcp_port > 65535 || udp_port < 0 || udp_port > 65535)
+    return;
+
+  m_outputs = std::make_unique<NetworkOutputs>("fzeroax", static_cast<u16>(tcp_port),
+                                               static_cast<u16>(udp_port));
+  m_outputs->Set("mamerun", 1);
+  m_outputs->Set("WheelServo", 0);
+  m_outputs->Set("WheelInit", 0);
+  for (const char* name : {"LampStart", "LampView1", "LampView2", "LampView3", "LampView4",
+                           "LampBoost", "LampLeader"})
+  {
+    m_outputs->Set(name, 0);
+  }
+}
