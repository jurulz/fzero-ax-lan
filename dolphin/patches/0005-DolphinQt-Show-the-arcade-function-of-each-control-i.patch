From 964a4224f46fc5a52b7de1700837dcaa8e959ced Mon Sep 17 00:00:00 2001
From: FZero AX LAN <noreply@users.noreply.github.com>
Date: Fri, 16 Oct 2026 14:25:16 -0400
Subject: [PATCH 5/6] DolphinQt: Show the arcade function of each control in
 the Triforce pad window

The Triforce baseboard is driven through a GameCube pad mapping. Say in the group titles what each control does in F-Zero AX (A = Boost, D-Pad = views, stick X = steering wheel, triggers = pedals...).
---
 .../DolphinQt/Config/Mapping/GCPadEmu.cpp     | 43 +++++++++++++------
 1 file changed, 31 insertions(+), 12 deletions(-)

diff --git a/Source/Core/DolphinQt/Config/Mapping/GCPadEmu.cpp b/Source/Core/DolphinQt/Config/Mapping/GCPadEmu.cpp
index a8af073..fe920af 100644
--- a/Source/Core/DolphinQt/Config/Mapping/GCPadEmu.cpp
+++ b/Source/Core/DolphinQt/Config/Mapping/GCPadEmu.cpp
@@ -20,24 +20,43 @@ void GCPadEmu::CreateMainLayout(SubType sub_type)
 {
   auto* layout = new QGridLayout;
 
-  layout->addWidget(CreateGroupBox(tr("Buttons"), Pad::GetGroup(GetPort(), PadGroup::Buttons)), 0,
-                    0);
-  layout->addWidget(CreateGroupBox(tr("D-Pad"), Pad::GetGroup(GetPort(), PadGroup::DPad)), 1, 0);
+  // Arcade (Triforce) cabinets are driven through this GameCube pad: say what each control does
+  // in F-Zero AX, since the labels below are the GameCube ones.
+  const bool arcade = sub_type == SubType::AMBaseboard;
+
+  layout->addWidget(
+      CreateGroupBox(arcade ? tr("Buttons: A = Boost, X = Left paddle, Y = Right paddle, "
+                                 "Start = Start (B, Z unused)") :
+                              tr("Buttons"),
+                     Pad::GetGroup(GetPort(), PadGroup::Buttons)),
+      0, 0);
+  layout->addWidget(CreateGroupBox(arcade ? tr("D-Pad: Right / Left / Up / Down = Views 1 / 2 / 3 / 4") :
+                                            tr("D-Pad"),
+                                   Pad::GetGroup(GetPort(), PadGroup::DPad)),
+                    1, 0);
 
   if (sub_type == SubType::AMBaseboard)
   {
-    layout->addWidget(CreateGroupBox(tr("Triforce"), Pad::GetGroup(GetPort(), PadGroup::Triforce)),
+    layout->addWidget(CreateGroupBox(tr("Triforce: Test, Service and Coin buttons"),
+                                     Pad::GetGroup(GetPort(), PadGroup::Triforce)),
                       2, 0);
   }
 
-  layout->addWidget(
-      CreateGroupBox(tr("Control Stick"), Pad::GetGroup(GetPort(), PadGroup::MainStick)), 0, 1, -1,
-      1);
-  layout->addWidget(CreateGroupBox(tr("C Stick"), Pad::GetGroup(GetPort(), PadGroup::CStick)), 0, 2,
-                    -1, 1);
-  layout->addWidget(CreateGroupBox(tr("Triggers"), Pad::GetGroup(GetPort(), PadGroup::Triggers)), 0,
-                    4);
-  layout->addWidget(CreateGroupBox(tr("Rumble"), Pad::GetGroup(GetPort(), PadGroup::Rumble)), 1, 4);
+  layout->addWidget(CreateGroupBox(arcade ? tr("Control Stick: X axis = Steering wheel") :
+                                            tr("Control Stick"),
+                                   Pad::GetGroup(GetPort(), PadGroup::MainStick)),
+                    0, 1, -1, 1);
+  layout->addWidget(CreateGroupBox(arcade ? tr("C Stick (unused by the game)") : tr("C Stick"),
+                                   Pad::GetGroup(GetPort(), PadGroup::CStick)),
+                    0, 2, -1, 1);
+  layout->addWidget(CreateGroupBox(arcade ? tr("Triggers: L = Brake pedal, R = Accelerator pedal") :
+                                            tr("Triggers"),
+                                   Pad::GetGroup(GetPort(), PadGroup::Triggers)),
+                    0, 4);
+  layout->addWidget(CreateGroupBox(arcade ? tr("Rumble (unused: force feedback is in FZeroFFB.ini)") :
+                                            tr("Rumble"),
+                                   Pad::GetGroup(GetPort(), PadGroup::Rumble)),
+                    1, 4);
 
   layout->addWidget(CreateGroupBox(tr("Options"), Pad::GetGroup(GetPort(), PadGroup::Options)), 2,
                     4);
-- 
